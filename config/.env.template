# Copy this file to .env in the project root and fill in real values.
# .env itself is never committed to git (it's in .gitignore).

# Path to the SQLite database file
DB_PATH=data/nifty100.db

# Port for the FastAPI server
PORT=8000

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Flag so the dashboard can visibly warn that stock_prices.xlsx
# and market_cap.xlsx are simulated, not real market data
SIMULATED_DATA_FLAG=True
